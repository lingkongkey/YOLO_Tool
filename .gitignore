# Visual Studio 用户状态与中间文件
.vs/
ipch/
*.aps
*.user
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.opendb

# 编译输出目录
x64/
Debug/
Release/

# Python 缓存与训练输出
__pycache__/
*.pyc
runs/

# 编译产物
*.obj
*.pdb
*.ilk
*.iobj
*.ipdb
*.tlog
*.log
*.recipe
*.exe
*.dll
*.lib
*.exp
*.res

# 项目依赖的第三方静态库（ncnn/opencv，体积数百 MB），不入库
c++/lib/x64/*.lib
c++/lib/x86/*.lib

# 项目依赖的第三方静态库（zlib），需要随源码入库
!File/lib/x86/
!File/lib/x86/**
!File/lib/x64/
!File/lib/x64/**
!File/lib/zlib/
!File/lib/**/*.lib
